    "firebase": "^12.16.0",
    "firebase-admin": "^14.5.1",
    "jsonwebtoken": "^9.0.2",
    "livekit-client": "^2.24.1",
    "livekit-server-sdk": "^2.20.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-firebase-hooks": "^5.1.1",
    "react-redux": "^9.2.0"
  },
  "engines": { "node": "22.x" },
  "overrides": {
    "jwks-rsa": { "jose": "5.10.0" },
    "@firebase/database-compat": "2.1.7",
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18",
    "@grpc/grpc-js": "1.14.7",
    "postcss": "8.5.33",
    "@typescript-eslint/typescript-estree": { "minimatch": "11.0.9" }
