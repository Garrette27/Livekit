rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Administrative claims never confer clinical access, including older
    // combined doctor/admin tokens. Bootstrap email configuration is server-only;
    // its historical claims must be separately migrated before real-clinic use.
    function clinicalClientAllowed() {
      return request.auth != null &&
        request.auth.token.get('admin', false) != true &&
        request.auth.token.get('role', '') != 'admin' &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') != 'admin');
    }
    // Helper function to check if user owns the resource
    function isOwner(resource) {
      return clinicalClientAllowed() && 
        (resource.data.createdBy == request.auth.uid || 
         resource.data.metadata.createdBy == request.auth.uid);
    }
    
    // Room and call names are claimed first-come by createdBy, and the server
    // treats rooms/{name}.createdBy as doctor ownership. Only a clinician
    // (trusted claim or server-provisioned profile) may claim a name, so a
    // patient account cannot squat a doctor's room name.
    function isClinician() {
      return clinicalClientAllowed() && (
        request.auth.token.get('role', '') == 'doctor' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'doctor')
      );
    }

    // Helper function to validate input data
    function isValidRoomData(data) {
      return data.keys().hasAll(['roomName', 'createdBy', 'createdAt', 'status']) &&
        data.roomName is string && data.roomName.size() >= 3 && data.roomName.size() <= 50 &&
        data.createdBy is string && data.createdBy.size() > 0 &&
        data.createdAt is timestamp &&
        data.status in ['active', 'completed', 'cancelled'];
    }
    
    // Helper function to validate call data
    function isValidCallData(data) {
      return data.keys().hasAll(['roomName', 'createdBy', 'createdAt', 'status']) &&
        data.roomName is string && data.roomName.size() >= 3 && data.roomName.size() <= 50 &&
        data.createdBy is string && data.createdBy.size() > 0 &&
        data.createdAt is timestamp &&
        data.status in ['active', 'completed', 'cancelled'];
    }
    
    // Rooms collection - users can only access their own rooms
    match /rooms/{roomId} {
      allow read, write: if request.auth != null && isOwner(resource);
      allow create: if isClinician() && 
        isValidRoomData(request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid;
    }
    
    // The doctor who owns rooms/{roomName}, by the same field precedence the
    // server uses (createdBy, then metadata.createdBy).
    function ownsRoom(roomName) {
      let roomPath = /databases/$(database)/documents/rooms/$(roomName);
      let room = get(roomPath).data;
      return exists(roomPath) && (
        room.get('createdBy', '') == request.auth.uid ||
        (room.get('createdBy', '') == '' &&
          room.get('metadata', {}).get('createdBy', '') == request.auth.uid)
      );
    }

    // calls/{roomName} is the browser transcript buffer for the room of the same
    // name, so it follows room ownership. A buffer left by an earlier holder of
    // the name may be taken over by the current room owner, but only in a write
    // that claims both owner fields and clears every stored line and note, so
    // the earlier holder's text never becomes readable to the new owner and the
    // earlier holder loses access to the new consultation.
    function isCallBufferTakeover(callId) {
      let data = request.resource.data;
      return clinicalClientAllowed() && ownsRoom(callId) &&
        data.get('createdBy', '') == request.auth.uid &&
        data.get('metadata', {}).get('createdBy', request.auth.uid) == request.auth.uid &&
        data.get('transcription', []).size() == 0 &&
        data.get('manualNotes', []).size() == 0;
    }

    // Calls collection - users can only access their own calls
    match /calls/{callId} {
      allow read, write: if request.auth != null && isOwner(resource);
      allow update: if isCallBufferTakeover(callId);
      allow create: if isClinician() && 
        isValidCallData(request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid;
    }
    
    // Server-owned encounter records retain current and legacy participant reads.
    // Identity, visibility, and lifecycle mutations require an authorized server
    // command; even an owning doctor must not rewrite them through the client.
    match /consultations/{consultationId} {
      // Helper function to check if user is a participant
      function isParticipant(resource) {
        let metadata = resource.data.metadata;
        let visibleToUsers = metadata != null ? metadata.visibleToUsers : [];
        return request.auth.uid == resource.data.patientUserId ||
               request.auth.uid == resource.data.createdBy ||
               request.auth.uid == metadata.createdBy ||
               request.auth.uid == metadata.patientUserId ||
               request.auth.uid == metadata.doctorUserId ||
               request.auth.uid in visibleToUsers;
      }
      
      // Allow read if user is the creator, patient, or in visibleToUsers
      allow read: if clinicalClientAllowed() && (
        resource.data.createdBy == request.auth.uid ||
        resource.data.patientUserId == request.auth.uid ||
        isParticipant(resource)
      );
      allow write: if false;
    }
    
    // Call summaries - read-only for doctors (creators only), write-only for server
    // NOTE: Patients should NOT have access to AI summaries - only doctors see these
    match /call-summaries/{summaryId} {
      // Only allow doctors (creators) to read summaries - patients cannot access
      allow read: if request.auth != null && isOwner(resource);
      // Only allow writes from server-side (admin SDK) - no client writes
      allow write: if false;
    }
    
    // users/{uid}: private email/role plus legacy profile fields. Client creates
    // use the bounded login schema; updates only refresh login time. Consent and
    // role provisioning are server-owned. Legacy fields can remain unchanged.
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['email', 'role']) &&
          data.email is string && data.email.size() > 0 && data.email.size() <= 320 &&
          data.role in ['patient', 'doctor', 'faculty_reviewer', 'admin'];
      }
      function isValidNewProfile(data) {
        return data.keys().hasOnly(['email', 'role', 'registeredAt', 'lastLoginAt',
            'consentGiven', 'doctorName', 'doctorEmail']) &&
          (!('doctorName' in data) || (data.doctorName is string && data.doctorName.size() <= 200)) &&
          (!('doctorEmail' in data) || data.doctorEmail == data.email) &&
          (!('consentGiven' in data) || data.consentGiven == false) &&
          (!('registeredAt' in data) || data.registeredAt == request.time) &&
          (!('lastLoginAt' in data) || data.lastLoginAt == request.time);
      }
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && 
        request.auth.uid == userId &&
        isValidUser(request.resource.data) && isValidNewProfile(request.resource.data) &&
        request.resource.data.email.lower() == request.auth.token.email.lower() &&
        (
          request.resource.data.role == 'patient' ||
          request.auth.token.get('role', '') == request.resource.data.role ||
          request.auth.token.get('admin', false) == true
        );
      // An owner cannot replace/delete/recreate their profile to assign a role,
      // inject permissions, rewrite consent evidence, or change their identity.
      allow update: if request.auth != null &&
        request.auth.uid == userId &&
        isValidUser(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']) &&
        request.resource.data.lastLoginAt == request.time;
      allow delete: if false;
    }
    
    // Audit logs - read-only for users, write-only for server
    match /audit-logs/{logId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || 
         request.auth.token.admin == true);
      allow write: if false; // Only server-side writes
    }

    // Admin activity feed - operational timeline for support and compliance workflows.
    match /admin-activity-feed/{eventId} {
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow write: if false; // Only server-side writes
    }

    // Reserved for future thesis-review assignments. No client route or UI is
    // enabled; a server endpoint must enforce permission + exact assignment.
    match /reviewAssignments/{assignmentId} {
      allow read, write: if false;
    }

    // Distributed API abuse counters are server-only.
    match /securityRateLimits/{counterId} {
      allow read, write: if false;
    }

    // Durable summary retries are operational server state.
    match /summaryJobs/{jobId} {
      allow read, write: if false;
    }

    // Prepared capability namespaces remain server-only and have no UI. Their
    // release gates are documented in docs/data-model-readiness.md.
    match /consultationSessions/{sessionId}/attachments/{attachmentId} {
      allow read, write: if false;

      match /{attachmentChildCollection}/{childId} {
        allow read, write: if false;
      }
    }

    match /appointments/{appointmentId} {
      allow read, write: if false;

      match /{appointmentChildCollection}/{childId} {
        allow read, write: if false;
      }
    }

    // Calendar serialization state is owned by the authenticated server service.
    match /appointmentCalendars/{doctorUserId} {
      allow read, write: if false;
    }
    
    // Sessions - users can only access their own sessions
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }
    
    // Scheduled deletions - users can only access their own scheduled deletions
    match /scheduled-deletions/{deletionId} {
      allow read, write: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }
    
    // Doctors may observe their own invitations. All invitation mutations and
    // nested security events go through server routes so a client cannot mint,
    // reactivate, or rewrite an invitation outside the domain policy.
    match /invitations/{invitationId} {
      allow read: if isClinician() &&
        resource.data.createdBy == request.auth.uid;
      allow write: if false;

      match /{securityEventCollection}/{eventId} {
        allow read, write: if false;
      }
    }
    
    // Waiting patients collection - doctors can read waiting patients for their invitations
    match /waitingPatients/{waitingPatientId} {
      // Allow read if the doctor's user ID matches the waiting patient's doctorUserId
      // This is simpler and more efficient than checking the invitation document
      allow read: if isClinician() && 
        resource.data.doctorUserId == request.auth.uid;
      // Only server can write (via admin SDK)
      allow write: if false;
    }
  }
}
