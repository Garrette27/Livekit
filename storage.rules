rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Attachments are prepared but not shipped. Keep every client path closed
    // until the server can issue session-scoped upload slots, scan content,
    // authorize downloads, and enforce retention. Authentication alone is not
    // permission to place clinical files in a user-chosen object path.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
